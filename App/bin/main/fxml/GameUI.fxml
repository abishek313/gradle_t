<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="15" alignment="CENTER"
      fx:controller="org.escaperoom.ui.controllers.GameController">

    <ImageView fx:id="backgroundImageView" fitHeight="400" fitWidth="600"/>

    <HBox spacing="20" alignment="CENTER">
        <Label fx:id="timerLabel" text="00:00"/>
        <Label fx:id="teusLabel" text="TEUs: 200"/>
        <Button fx:id="hintButton" text="Buy Hint (50 TEUs)" onAction="#handleHint"/>
        <Label fx:id="hintLabel" text="Hint will appear here"/>
    </HBox>

    <Label text="Inventory:"/>
    <ListView fx:id="inventoryList" prefHeight="80"/>

    <Label text="Items in room:"/>
    <VBox fx:id="itemsBox" spacing="10"/>

    <Label text="Puzzles in room:"/>
    <VBox fx:id="puzzlesBox" spacing="10"/>
</VBox>
