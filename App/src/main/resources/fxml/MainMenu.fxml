<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.escaperoom.ui.controllers.MainMenuController"
           fx:id="rootPane"
           style="-fx-background-color: black;">

    <!-- Background image that scales with window -->
    <ImageView fx:id="backgroundImageView" preserveRatio="false">
        <image>
            <Image url="@/images/menu_bg.png"/>
        </image>
    </ImageView>

    <!-- Buttons at the bottom -->
    <VBox spacing="20" alignment="BOTTOM_CENTER" StackPane.alignment="BOTTOM_CENTER" style="-fx-padding: 30;">
        <Button fx:id="startBtn" text="Start Game" prefWidth="200"/>
        <Button fx:id="settingsBtn" text="Settings" prefWidth="200"/>
        <Button fx:id="exitBtn" text="Exit" prefWidth="200"/>
    </VBox>
</StackPane>
